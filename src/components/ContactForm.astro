---
import { languageNames, locales, type Locale } from '../content/copy';
import { contactCopy } from '../content/contact';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = contactCopy[locale];
---
<form action="/api/contact/" method="post" data-contact data-sending={t.sending}
  data-sent={t.sent} data-invalid={t.invalid} data-failed={t.failed}>
  <input type="hidden" name="locale" value={locale} />
  <div>
    <label>{t.name}<input name="name" autocomplete="name" minlength="2" maxlength="100" required aria-describedby="contact-name-error" /></label>
    <p class="field-error" id="contact-name-error"></p>
  </div>
  <div>
    <label>{t.email}<input type="email" name="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" /></label>
    <p class="field-error" id="contact-email-error"></p>
  </div>
  <div>
    <label>{t.phone}<input type="tel" name="phone" autocomplete="tel" maxlength="50" aria-describedby="contact-phone-error" /></label>
    <p class="field-error" id="contact-phone-error"></p>
  </div>
  <div>
    <label>{t.subject}<input name="subject" minlength="5" maxlength="150" required aria-describedby="contact-subject-error" /></label>
    <p class="field-error" id="contact-subject-error"></p>
  </div>
  <div class="full">
    <label>{t.replyLanguage}
      <select name="replyLocale" aria-describedby="contact-replyLocale-error">
        {locales.map((language) => (
          <option value={language} lang={language} selected={language === locale}>{languageNames[language]}</option>
        ))}
      </select>
    </label>
    <p class="field-error" id="contact-replyLocale-error"></p>
  </div>
  <div class="full">
    <label>{t.message}<textarea name="message" rows="5" minlength="10" maxlength="3000" required aria-describedby="contact-message-error"></textarea></label>
    <p class="field-error" id="contact-message-error"></p>
  </div>
  <div hidden><input name="website" tabindex="-1" autocomplete="off" /></div>
  <div class="full">
    <button type="submit" class="action">{t.send}</button>
    <p role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { locales } from '../content/copy';
  import { contactFields, validateContact, type ContactErrors, type ContactField } from '../lib/contact-validation';

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const button = form?.querySelector('button');
  const status = form?.querySelector('[role="status"]');

  if (form && button && status) {
    function setError(field: ContactField, message?: string) {
      const input = form?.elements.namedItem(field);
      const error = form?.querySelector(`#contact-${field}-error`);
      if (!(input instanceof HTMLElement) || !error) return;

      error.textContent = message ?? '';
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }

    function showErrors(errors: ContactErrors) {
      for (const field of contactFields) setError(field, errors[field]);
      form?.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    }

    form.noValidate = true;
    for (const field of contactFields) {
      const input = form.elements.namedItem(field);
      if (input instanceof HTMLElement) input.addEventListener('input', () => setError(field));
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const data = new FormData(form);
      const locale = locales.find((language) => language === data.get('locale')) ?? 'en';
      const result = validateContact(Object.fromEntries(data), locale);
      if (!result.success) {
        status.textContent = form.dataset.invalid ?? '';
        showErrors(result.fieldErrors);
        return;
      }

      showErrors({});
      button.disabled = true;
      status.textContent = form.dataset.sending ?? '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new URLSearchParams(Array.from(data, ([key, value]) => [key, String(value)])),
        });
        if (response.ok) form.reset();
        if (response.status === 400) {
          const body: { fieldErrors?: ContactErrors } = await response.json();
          showErrors(body.fieldErrors ?? {});
        }
        const key = response.ok ? 'sent' : response.status === 400 ? 'invalid' : 'failed';
        status.textContent = form.dataset[key] ?? '';
      } catch {
        status.textContent = form.dataset.failed ?? '';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  label { display: grid; gap: .45rem; font-size: .925rem; }
  input, select, textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: .7rem .85rem;
    border: 1px solid #777068;
    border-radius: .75rem;
    background: #24211e;
    color: var(--cream);
    font: inherit;
    font-size: 1rem;
  }
  textarea { resize: vertical; }
  input[aria-invalid="true"], select[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: #ffab8a; }
  .field-error:not(:empty) { margin-top: .35rem; color: #ffab8a; font-size: .875rem; }
  .full { grid-column: 1 / -1; }
  [role="status"]:not(:empty) { margin-top: .75rem; }
  button:disabled { opacity: .65; cursor: wait; }
  @media (max-width: 30rem) { form { grid-template-columns: 1fr; } }
</style>
